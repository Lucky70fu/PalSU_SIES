DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional ClamAV upload scanning
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_REQUIRED=False

# Live payment gateway credentials are intentionally not configured here.

# Password reset email (local default prints reset emails in the Django terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=PalSU Enrollment System <no-reply@example.com>
